{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyEksClusterUpgradeToBelowMinimumVersion",
      "Effect": "Deny",
      "Action": "eks:UpdateClusterVersion",
      "Resource": "*",
      "Condition": {
        "StringLessThan": {
          "eks:kubernetesVersion": "1.31"
        },
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::*:role/BreakGlassEKSAdmin"
        }
      }
    }
  ]
}
